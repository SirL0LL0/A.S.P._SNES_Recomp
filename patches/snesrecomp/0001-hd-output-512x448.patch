 void ppu_draw_whole_line_legacy(Ppu *ppu, int line) {
   // actual line
   if (PPU_mode(ppu) == 7)
     ppu_prepare_mode7(ppu, line);
   int left = -ppu->extraLeftCur;
   int right = 256 + ppu->extraRightCur;
-  for (int x = left; x < right; x++) {
-    ppu_render_pixel(ppu, x, line);
-  }
+  PpuLegacySpanArgs args = {ppu, line};
+  if (s_span_executor)
+    s_span_executor(ppu_render_span, &args, left, right);
+  else
+    ppu_render_span(&args, left, right);
+}
