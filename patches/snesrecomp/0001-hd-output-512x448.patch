+/* Parallel line rendering (A.S.P. patch). The per-dot work below only READS
+ * the PPU (registers, VRAM, CGRAM, the line's sprite buffer) and writes its
+ * own dots, so a host may split a line's dots across threads. The result is
+ * identical for any split. NULL = render on the calling thread. */
+static PpuLegacySpanExecutor *s_span_executor;
+
+void ppu_legacy_set_span_executor(PpuLegacySpanExecutor *executor) {
+  s_span_executor = executor;
+}
+
+typedef struct { Ppu *ppu; int line; } PpuLegacySpanArgs;
+
+static void ppu_render_span(void *ctx, int begin, int end) {
+  const PpuLegacySpanArgs *a = (const PpuLegacySpanArgs *)ctx;
+  for (int x = begin; x < end; x++)
+    ppu_render_pixel(a->ppu, x, a->line);
+}
