+/* Field used for interlaced BG fetches in modes 5/6. -1 = the hardware's
+ * current field (ppu->evenFrame); 0/1 = forced, used by the deinterlacer. */
+static int s_legacy_field = -1;
+
+static void ppu_compute_pixel(Ppu *ppu, int x, int y,
+                              int *pr, int *pg, int *pb,
+                              int *pr2, int *pg2, int *pb2);
+
 static void ppu_render_pixel(Ppu *ppu, int x, int y) {
+  int r, g, b, r2, g2, b2;
+  bool hires = PPU_pseudoHires(ppu) || PPU_mode(ppu) == 5 || PPU_mode(ppu) == 6;
+  if (!PPU_forcedBlank(ppu) && PPU_interlace(ppu) &&
+      (PPU_mode(ppu) == 5 || PPU_mode(ppu) == 6)) {
+    /* Deinterlace: a 448-line image is shown on 224 rows by alternating
+     * fields every frame, which flickers on a progressive display. Render
+     * both fields and blend them instead. */
+    int fr, fg, fb, fr2, fg2, fb2;
+    s_legacy_field = 0;
+    ppu_compute_pixel(ppu, x, y, &r, &g, &b, &r2, &g2, &b2);
+    s_legacy_field = 1;
+    ppu_compute_pixel(ppu, x, y, &fr, &fg, &fb, &fr2, &fg2, &fb2);
+    s_legacy_field = -1;
+    r = (r + fr + 1) >> 1; g = (g + fg + 1) >> 1; b = (b + fb + 1) >> 1;
+    r2 = (r2 + fr2 + 1) >> 1; g2 = (g2 + fg2 + 1) >> 1; b2 = (b2 + fb2 + 1) >> 1;
+  } else {
+    ppu_compute_pixel(ppu, x, y, &r, &g, &b, &r2, &g2, &b2);
+  }
+  if (hires) {
+    /* Hi-res: the 512-pixel line alternates sub (even) and main (odd)
+     * columns. The 256-wide output used to keep only main, dropping half of
+     * every glyph; blend the two half-pixels. */
+    r = (r + r2 + 1) >> 1; g = (g + g2 + 1) >> 1; b = (b + b2 + 1) >> 1;
+  }
+  int row = y - 1;
+  uint8 *pixelBuffer = (uint8 *)&ppu->renderBuffer[row * ppu->renderPitch + (x + ppu->extraLeftRight) * 4];
+  pixelBuffer[0] = ((b << 3) | (b >> 2)) * PPU_brightness(ppu) / 15;
+  pixelBuffer[1] = ((g << 3) | (g >> 2)) * PPU_brightness(ppu) / 15;
+  pixelBuffer[2] = ((r << 3) | (r >> 2)) * PPU_brightness(ppu) / 15;
+  pixelBuffer[3] = 0;
+}
+
+static void ppu_compute_pixel(Ppu *ppu, int x, int y,
+                              int *pr, int *pg, int *pb,
+                              int *pr2, int *pg2, int *pb2) {
   int r = 0, r2 = 0;
   int g = 0, g2 = 0;
   int b = 0, b2 = 0;
@@ -129,12 +172,8 @@ static void ppu_render_pixel(Ppu *ppu, int x, int y) {
       r2 = r; g2 = g; b2 = b;
     }
   }
-  int row = y - 1;
-  uint8 *pixelBuffer = (uint8 *)&ppu->renderBuffer[row * ppu->renderPitch + (x + ppu->extraLeftRight) * 4];
-  pixelBuffer[0] = ((b << 3) | (b >> 2)) * PPU_brightness(ppu) / 15;
-  pixelBuffer[1] = ((g << 3) | (g >> 2)) * PPU_brightness(ppu) / 15;
-  pixelBuffer[2] = ((r << 3) | (r >> 2)) * PPU_brightness(ppu) / 15;
-  pixelBuffer[3] = 0;
+  *pr = r; *pg = g; *pb = b;
+  *pr2 = r2; *pg2 = g2; *pb2 = b2;
 }
 
 static int ppu_resolve_pixel(Ppu *ppu, int x, int y, bool sub,
@@ -171,7 +210,9 @@ static int ppu_resolve_pixel(Ppu *ppu, int x, int y, bool sub,
             lx += (sub || PPU_mosaicEnabled(ppu, curLayer)) ? 0 : 1;
             if (PPU_interlace(ppu)) {
               ly *= 2;
-              ly += (ppu->evenFrame || PPU_mosaicEnabled(ppu, curLayer)) ? 0 : 1;
+              ly += PPU_mosaicEnabled(ppu, curLayer) ? 0
+                  : s_legacy_field >= 0 ? s_legacy_field
+                  : (ppu->evenFrame ? 0 : 1);
             }
           }
           ly += ppu->vScroll[curLayer];
