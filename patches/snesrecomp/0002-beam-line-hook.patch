+/* Per-scanline hook (A.S.P. patch): called each time the beam enters a new
+ * scanline, with the new line number. A host that renders while the beam
+ * runs ("beam racing") draws line v here, after the HDMA for v has run at
+ * the previous line's H-blank and before any later CPU write lands. */
+static SnesBeamLineHook s_beam_line_hook;
+void snes_set_beam_line_hook(SnesBeamLineHook hook) { s_beam_line_hook = hook; }
+
 static bool s_raster_irq_beam_off;
 void snes_set_raster_irq_beam_enabled(bool enabled) {
   s_raster_irq_beam_off = !enabled;
@@ -462,6 +469,9 @@ static uint32_t snes_advance_beam(Snes *snes, uint32_t clocks, bool check_irq) {
           h = 0; v++; if (v >= 262u) v = 0;
           if (v == 225u) snes->rdnmiPending = true;
           if (v == 0u) snes->rdnmiPending = false;
+          snes->hPos = (uint16_t)h;
+          snes->vPos = (uint16_t)v;
+          if (s_beam_line_hook) s_beam_line_hook(snes, v);
         }
         snes->hPos = (uint16_t)h;
         snes->vPos = (uint16_t)v;
@@ -508,6 +518,12 @@ static uint32_t snes_advance_beam(Snes *snes, uint32_t clocks, bool check_irq) {
         }
         snes->dbgLatchedThisField = 0;
       }
+      if (s_beam_line_hook) {
+        snes->hPos = (uint16_t)h;
+        snes->vPos = (uint16_t)v;
+        snes->inVblank = v >= 225u;
+        s_beam_line_hook(snes, v);
+      }
     }
   }
   snes->hPos = (uint16_t)h;
